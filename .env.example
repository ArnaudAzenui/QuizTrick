# Copy to .env.local for local development. On Vercel, set these as Environment Variables (WBS 1.3.4.4).
# NEVER commit .env.local (SEC-3).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used only by src/backend for answer-key access and grading.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI quiz-generation service (server-only, FR-3.9 / SEC-3) ---
# Provider is isolated in src/backend/services/ai (NFR-M3). "openai" is the default.
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible chat-completions endpoint.
AI_BASE_URL=https://api.openai.com/v1

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
